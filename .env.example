# ======================================================================
# RAG Benchmark & Playground — przykladowa konfiguracja srodowiska
# Skopiuj do `.env` i dostosuj. NIE commituj pliku `.env`.
# Wartosci hostow sa dla backendu uruchamianego lokalnie; docker-compose
# nadpisuje je dla kontenerow (DB_HOST, OLLAMA_BASE_URL, UPLOAD_DIR).
# ======================================================================

# --- Backend / API ---
APP_ENV=development
CORS_ORIGINS='["http://localhost:8501"]'

# --- Baza danych (PostgreSQL + pgvector: metadane, wyniki i wektory) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_benchmark
DB_USER=rag
DB_PASSWORD=rag
# Wymiar wektora — musi zgadzac sie z modelem embeddingowym (nomic-embed-text: 768)
EMBEDDING_DIM=768

# --- Kolejka zadan (Celery + Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Warstwa modeli (LLM / embeddingi) ---
# Identyfikatory modeli LiteLLM: prefiks wybiera dostawce (ollama_chat/, openai/, anthropic/, ...)
OLLAMA_BASE_URL=http://localhost:11434

# Model generatywny i sedzia (LLM-as-a-Judge) — ten sam, by nie przeladowywac VRAM
GENERATION_MODEL=ollama_chat/qwen3:8b
JUDGE_MODEL=ollama_chat/qwen3:8b
# Lzejszy model na czas szybkich testow podczas pisania kodu:
# GENERATION_MODEL=ollama_chat/qwen3:1.7b

# Model embeddingowy
EMBEDDING_MODEL=ollama/nomic-embed-text

# Reranker (Sentence-Transformers, ladowany w procesie Pythona)
# EN: BAAI/bge-reranker-base | PL/multi: BAAI/bge-reranker-v2-m3
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Opcjonalne komercyjne API (Should-have) ---
# Klucze czyta LiteLLM bezposrednio ze srodowiska, np.:
# OPENAI_API_KEY=

# --- Wykonywanie eksperymentow ---
# Lokalne modele: wymuszamy sekwencyjne przetwarzanie (1 zapytanie naraz)
MAX_CONCURRENT_LLM_CALLS=1
JUDGE_TEMPERATURE=0
