# ======================================================================
# RAG Benchmark & Playground — przykladowa konfiguracja srodowiska
# Skopiuj do `.env` i dostosuj. NIE commituj pliku `.env`.
# ======================================================================

# --- Backend / API ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# CORS dla frontendu (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- Baza relacyjna (SQLite) ---
DATABASE_URL=sqlite:///./data/sqlite/app.db

# --- Baza wektorowa ---
# Dostawca: qdrant | chroma
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333

# --- Warstwa modeli (LLM / embeddingi) ---
# Dostawca: ollama | openai  (adapter kompatybilny z OpenAI API)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model generatywny i sedzia (LLM-as-a-Judge) — ten sam, by nie przeladowywac VRAM
GENERATION_MODEL=qwen3:8b
JUDGE_MODEL=qwen3:8b
# Lzejszy model na czas szybkich testow podczas pisania kodu:
# GENERATION_MODEL=qwen3:1.7b

# Model embeddingowy
EMBEDDING_MODEL=nomic-embed-text

# Reranker (Sentence-Transformers, ladowany w procesie Pythona)
# EN: BAAI/bge-reranker-base | PL/multi: BAAI/bge-reranker-v2-m3
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Opcjonalne komercyjne API (Should-have) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Wykonywanie eksperymentow ---
# Lokalne modele: wymuszamy sekwencyjne przetwarzanie (1 zapytanie naraz)
MAX_CONCURRENT_LLM_CALLS=1
JUDGE_TEMPERATURE=0
